# Copy to secrets.toml at this repo root (gitignored). Paste the same TOML into Streamlit Cloud Secrets.
# Flat keys load into app config; [auth] is for Streamlit Google login only.
# Run: just link-secrets  (symlinks .streamlit/secrets.toml → ../secrets.toml for st.login)

NOTION_API_KEY = "secret"
NOTION_RECIPE_DATABASE_ID = "uuid"
NOTION_PANTRY_DATABASE_ID = "uuid"
NOTION_RECURRING_WEEKLY_DATABASE_ID = "uuid"
NOTION_WEEKLY_MEAL_PLANS_DATABASE_ID = "uuid"
NOTION_DEBUG_LOGS_DATABASE_ID = "uuid"

GROCERY_WIZARD_DEFAULT_MEALS = 5
GROCERY_WIZARD_REQUIRE_AUTH = false
GROCERY_WIZARD_AUTH_EMAIL_ALLOWLIST = "you@example.com,partner@example.com"

GITHUB_FEEDBACK_REPOSITORY = "rachelgramlich/grocery-wizard"
GITHUB_FEEDBACK_TOKEN = "github_pat_…"

NYT_S_COOKIE = "…"
NYT_REGI_ID = "…"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "long-random-string"
client_id = "….apps.googleusercontent.com"
client_secret = "GOCSPX-…"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
